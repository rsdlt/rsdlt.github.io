---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import profilePhoto from "@/assets/images/rodrigo.jpeg";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import LinkButton from "@/components/LinkButton.astro";
import Socials from "@/components/Socials.astro";
import config from "@/config";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { personSchema } from "@/utils/personSchema";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const foambytePostCount = sortedPosts.filter(({ data }) =>
	data.tags.includes("foambyte"),
).length;
const leviPostCount = sortedPosts.filter(({ data }) =>
	data.tags.includes("levi"),
).length;
const homePath = getRelativeLocaleUrl(locale, "");
const profileSchema = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	url: config.site.url,
	mainEntity: {
		...personSchema,
		image: new URL(profilePhoto.src, Astro.site).href,
	},
};
const bioLinkClass =
	"hover:text-accent underline decoration-dashed underline-offset-4";
---

<Layout>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(profileSchema)}
  />
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <div class="my-4 flex items-center gap-4 sm:my-8 sm:gap-6">
        <Image
          src={profilePhoto}
          alt="Rodrigo Santiago"
          width={192}
          height={192}
          loading="eager"
          class="border-accent size-20 shrink-0 rounded-full border-2 sm:size-24"
        />
        <div>
          <h1 class="inline-block text-4xl font-bold sm:text-5xl">
            Rodrigo Santiago
          </h1>
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="inline-block"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss
              width={20}
              height={20}
              class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
            />
            <span class="sr-only">RSS Feed</span>
          </a>
        </div>
      </div>

      <p>
        I'm a product leader who builds. I've spent nearly 15 years taking
        digital products from strategy to launch in fintech and telecom, and I
        still ship production code, now with AI coding agents working inside the
        guard rails I'd expect from a professional engineering team.
      </p>

      <h2 class="mt-6 mb-2 text-lg font-semibold">Hands-on engineering</h2>
      <p>
        I co-founded <a
          href="https://foambyte.com"
          target="_blank"
          rel="noopener"
          class={bioLinkClass}>Foambyte®</a
        >, a production-management platform for craft brewers, with my brother
        Diego, a brewmaster with 12+ years of experience who leads the product
        as CPO. I'm the CEO and lead the engineering: I designed and built the
        entire platform (architecture, frontend, backend, mobile and
        infrastructure) using React, TypeScript, Hono, TanStack, Tailwind,
        CapacitorJS, and edge infrastructure on Cloudflare and PlanetScale
        Postgres. Together we've grown it to 100+ users in 3 countries.
      </p>

      <h2 class="mt-6 mb-2 text-lg font-semibold">How I build</h2>
      <p>
        I write software with AI coding agents (Claude Code) the way I'd run an
        engineering team. I own the architecture and every decision, and the
        agents work from written conventions and project-specific skills. I
        review every diff myself before it's committed, and I run security
        audits on the codebase, turning their findings into fixes and
        regression tests. Nothing ships without passing type checks, the
        automated test suite and a license check in the deploy gate, then
        verification on staging. Database migrations and production releases
        stay in my hands.
        <a
          href={getRelativeLocaleUrl(
            locale,
            "posts/claude-code-production-saas-ai-coding-guardrails",
          )}
          class={bioLinkClass}>More on how I work with Claude Code</a
        >.
      </p>

      <h2 class="mt-6 mb-2 text-lg font-semibold">
        Product &amp; business leadership
      </h2>
      <p>
        At <a
          href="https://www.fiserv.com"
          target="_blank"
          rel="noopener"
          class={bioLinkClass}>Fiserv</a
        > I led product strategy for Digital Solutions (online &amp; mobile banking,
        mobile card management, mobile wallet) across Latin America and the Caribbean.
        I launched the DigitalAccess omni-channel platform, push provisioning, and
        a developer portal for banking APIs, and my team delivered double-digit revenue
        growth and beat quota six years in a row. At Nextel México (now <a
          href="https://www.att.com.mx"
          target="_blank"
          rel="noopener"
          class={bioLinkClass}>AT&amp;T México</a
        >) I led a 15+ person team and launched 3G voice &amp; data services
        and top-up channels with BBVA, HSBC and Walmart, worth tens of millions
        of USD a year.
      </p>

      <p class="text-muted-foreground mt-6">
        Languages: English &amp; Spanish · basic Portuguese
      </p>

      <p class="mt-4">
        Read the
        <a href={getRelativeLocaleUrl(locale, "foambyte")} class={bioLinkClass}
          >Foambyte engineering series</a
        >: {foambytePostCount} posts on the architecture behind the platform.
      </p>

      <p class="mt-4">
        Read
        <a href={getRelativeLocaleUrl(locale, "levi")} class={bioLinkClass}
          >Building levi</a
        >: {leviPostCount} {leviPostCount === 1 ? "post" : "posts"} on building a Rust git diff viewer with Claude
        Code.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
