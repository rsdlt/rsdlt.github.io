---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import profilePhoto from "@/assets/images/rodrigo.jpeg";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <div class="my-4 flex items-center gap-4 sm:my-8 sm:gap-6">
        <Image
          src={profilePhoto}
          alt="Rodrigo Santiago"
          width={192}
          height={192}
          loading="eager"
          class="border-accent size-20 shrink-0 rounded-full border-2 sm:size-24"
        />
        <div>
          <h1 class="inline-block text-4xl font-bold sm:text-5xl">
            Rodrigo Santiago
          </h1>
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="inline-block"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss
              width={20}
              height={20}
              class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
            />
            <span class="sr-only">RSS Feed</span>
          </a>
        </div>
      </div>

      <p>
        I'm a product leader who builds. I've spent nearly 15 years taking
        digital products from strategy to launch in fintech and telecom, and I
        write the code myself.
      </p>

      <h2 class="mt-6 mb-2 text-lg font-semibold">Hands-on engineering</h2>
      <p>
        I co-founded Foambyte®, a production-management platform for craft
        brewers, with my brother Diego, a brewmaster with 12+ years of
        experience who leads the product as CPO. I'm the CEO and the only
        developer: I designed and built the entire platform (architecture,
        frontend, backend, mobile and infrastructure) using React, TypeScript,
        Hono, TanStack, Tailwind, CapacitorJS, and edge infrastructure on
        Cloudflare and PlanetScale Postgres. Together we've grown it to 100+
        users in 3 countries.
      </p>

      <h2 class="mt-6 mb-2 text-lg font-semibold">
        Product &amp; business leadership
      </h2>
      <p>
        At Fiserv I led product strategy for Digital Solutions (online &amp;
        mobile banking, card management, mobile wallet, payments) across Latin
        America and the Caribbean. I launched the DigitalAccess omni-channel
        platform, push provisioning, and a developer portal for banking APIs,
        and my team delivered double-digit revenue growth and beat quota six
        years in a row. At Nextel México (now AT&amp;T México) I led a 15+
        person team and launched 4G LTE voice &amp; data services and top-up
        channels with BBVA, HSBC and Walmart, worth tens of millions of USD a
        year.
      </p>

      <p class="text-muted-foreground mt-6">
        Languages: English &amp; Spanish · basic Portuguese
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
