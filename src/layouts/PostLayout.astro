---
import Layout from "./Layout.astro";
import config from "@/config";
import { personSchema } from "@/utils/personSchema";
import "katex/dist/katex.min.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  tags?: string[];
  /** Post title without the site suffix, for the JSON-LD headline */
  headline?: string;
};

const { site } = config;

const {
  title,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  headline,
} = Astro.props;

const pageURL = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
const lastModified = modDatetime ?? pubDatetime;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: headline ?? title ?? site.title,
  ...(description && { description }),
  url: pageURL,
  mainEntityOfPage: { "@type": "WebPage", "@id": pageURL },
  ...(ogImage && { image: ogImage }),
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(lastModified && { dateModified: lastModified.toISOString() }),
  ...(tags?.length && { keywords: tags.join(", ") }),
  inLanguage: site.lang,
  author: [personSchema],
  publisher: { "@id": personSchema["@id"] },
  isPartOf: { "@type": "Blog", name: site.title, url: site.url },
};
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <Fragment slot="head">
    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />

    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
